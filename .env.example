# ---------------------------------------------------------------
# LedgerFlow environment — copy to .env and fill in real values.
# Never commit .env.
# ---------------------------------------------------------------

# --- Database (remote MySQL) ---
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# --- Auth (Auth.js / NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
APP_URL="http://localhost:3000"
APP_NAME="LedgerFlow"

# --- OpenAI (server-side only) ---
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.6-luna"

# --- Analytics (optional) ---
NEXT_PUBLIC_META_PIXEL_ID=""

# --- File storage (logos, later receipts/documents) ---
# local = ./storage/uploads (development only; not available on Vercel)
# s3    = private AWS S3 bucket (or any S3-compatible store)
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""                 # e.g. us-west-2 — same region as your app/DB
# IAM user keys limited to this bucket. Named S3_* because Vercel reserves AWS_*.
# Leave empty to use the default AWS credential chain (IAM role, SSO profile).
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Only for S3-compatible providers (Cloudflare R2, MinIO). Leave empty for AWS.
S3_ENDPOINT=""
# Optional override for local uploads directory.
# STORAGE_LOCAL_DIR=""
